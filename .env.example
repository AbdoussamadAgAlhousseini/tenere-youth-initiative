# ----------------------------------------------------------------------------
# Tenere Youth Initiative — Environment variables
# Copy this file to `.env` and fill in the values.
# ----------------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (PostgreSQL) — Supabase (Settings → Database → Connection string)
# DATABASE_URL = Connection pooling URI (port 6543) + ?pgbouncer=true
# DIRECT_URL   = Direct connection URI (port 5432), used for migrations
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-strong-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cloudinary (media) — optional in dev
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Rate limiting (Upstash) — optional; in-memory fallback used in dev
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
